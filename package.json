{
  "name": "guo-position-finder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run prepare:english && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "data": ".venv/bin/python scripts/import_data.py && npm run prepare:english",
    "test": "tsx --test src/*.test.ts",
    "prepare:english": "tsx scripts/prepare_english.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^6.1.0",
    "tsx": "^4.20.0"
  }
}
